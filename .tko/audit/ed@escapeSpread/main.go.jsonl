sited[nr][nc] = true\n\t\t\t\t\t\t\t\tplayerQueue = append(playerQueue, Point{nr, nc})\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\tif time < fireTime[nr][nc] {\n\t\t\t\t\t\t\t\tvisited[nr][nc] = true\n\t\t\t\t\t\t\t\tplayerQueue = append(playerQueue, Point{nr, nc})\n\t\t\t\t\t\t\t}\n"},{"tag":"insert","a1":103,"a2":103,"text":"\t\treturn false\n\t} // <-- ATENÇÃO: Aqui fecha APENAS a função canEscape\n\n\t// 4. Testes de borda\n\tif !canEscape(0) {\n\t\treturn -1\n"},{"tag":"replace","a1":104,"a2":113,"text":"\tif canEscape(INF) {\n\t\treturn INF\n\t}\n"},{"tag":"replace","a1":114,"a2":121,"text":"\t// 5. Busca Binária pelo tempo máximo\n\tlow, high := 0, INF\n\tans := 0\n\n\tfor low <= high {\n\t\tmid := low + (high-low)/2\n\t\tif canEscape(mid) {\n\t\t\tans = mid\n\t\t\tlow = mid + 1\n\t\t} else {\n\t\t\thigh = mid - 1\n\t\t}\n"},{"tag":"replace","a1":122,"a2":124,"text":"\n\treturn ans\n"},{"tag":"replace","a1":132,"a2":133,"text":"\tfmt.Sscanf(scanner.Text(), \"%d %d\", &nl, &nc)\n"},{"tag":"insert","a1":140,"a2":140,"text":"\n\tfmt.Println(numIslands(grid))\n"}]}
